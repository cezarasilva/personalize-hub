# ============================================================
# PERSONALIZE Hub — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env no repositório.
# ============================================================

# ---- Servidor ----
NODE_ENV=production          # "production" | "development"
PORT=3000

# ---- Banco de Dados (PostgreSQL) ----
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco

# ---- Autenticação JWT ----
# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=seu_jwt_secret_muito_longo_e_aleatorio

# ---- Supabase Storage (imagens) ----
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua_supabase_service_role_key

# ---- Email (Resend) ----
RESEND_API_KEY=re_sua_chave_api
RESEND_FROM=PERSONALIZE Hub <noreply@seudominio.com.br>

# ---- CORS ----
# Origens permitidas separadas por vírgula.
# Deixe vazio para permitir todas as origens (não recomendado em produção).
ALLOWED_ORIGINS=https://seudominio.com.br,https://www.seudominio.com.br
